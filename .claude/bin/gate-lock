#!/usr/bin/env python3
"""Run a heavy command (the gate) one at a time on a shared machine. Standard library only.

    gate-lock run [options] -- <command> [args…]    wait for the lock, run, release, exit with the command's code
    gate-lock status [--lock DIR]                    exit 0 if free, 1 if held (and say by whom)
    gate-lock --self-test

Why: several builders gating at once on one machine turn timing tests red for reasons that have
nothing to do with the diff (a test took 220 s beside two siblings and 29 s alone). A "wait until
the machine is quiet" check starts every waiter in the same poll; a lock does not. The traps a
hand-rolled lock fell into are closed here by construction:

  * Atomic `mkdir` of one directory, shared by every checkout on the machine; a waiter holds
    no lock while it waits (so a lock is never held across a wait of unknown length).
  * First come, first served: each waiter puts a ticket in `<lock>.q/` and only the oldest live
    ticket may try the lock, so a slow poller is not starved. Tickets not touched for a while
    are dead and ignored. A waiter reports who holds the lock every few minutes.
  * The lock is yours only if YOUR `mkdir` succeeded. A lock that exists with no owner file yet
    belongs to a sibling between its `mkdir` and its owner write; it is never filled in.
  * Stale rule: a lock older than --stale-min (default 30, longer than your longest gate) is
    removed by rename, so two waiters cannot both clear it. The age is never refreshed.
  * Dead owner (and dead waiters): a lock whose wrapper process is gone (killed hard, which no handler survives) and
    whose command is gone too, on this host, is cleared at once instead of after the stale rule.
    The owner file names the wrapper's pid and host; the command's pid is written beside it once
    it starts. A lock with no pid, another host's lock, or one whose command still runs waits.
    A queued ticket whose waiter is gone is dropped the same way instead of after its time to live.
  * Release only a lock whose owner file still names this run, whether the command passed,
    failed, timed out or was killed with SIGINT/SIGTERM; otherwise it warns and leaves the lock.
  * --wait-free DIR (repeatable) also waits for another lock, e.g. a lab slot, to read free
    before taking this one, so a long job and a gate never start beside each other.

Options: --lock DIR (default $GATE_LOCK_DIR or <tmp>/claude-gate.lock), --owner NAME, --stale-min N,
--timeout-min N (give up waiting; default 0 = wait forever), --poll SECONDS (default 5),
--report-min N (say who holds it every N minutes, default 5), --wait-free DIR.

Exit codes of its own: 64 usage, 75 timed out waiting for the lock. Anything else is the command's.
A foreground call that hits a tool's time limit can leave the wrapper running: start it in the
background and wait for it to finish, or the next command runs unlocked.
"""
import getpass, os, shutil, signal, socket, subprocess, sys, tempfile, time

DEFAULT_LOCK = os.environ.get("GATE_LOCK_DIR") or os.path.join(tempfile.gettempdir(), "claude-gate.lock")
EX_USAGE, EX_WAIT = 64, 75


def _age(path):
    return time.time() - os.stat(path).st_mtime


def _owner(lock):
    try:
        with open(os.path.join(lock, "owner"), encoding="utf-8") as f:
            return f.read().splitlines()[0]
    except (OSError, IndexError):
        return None


def _alive(pid):
    """Is a process with this pid running? True when it cannot tell."""
    if pid <= 0:
        return False
    if os.name == "nt":
        try:
            import ctypes
            k32 = ctypes.windll.kernel32
            k32.OpenProcess.restype = ctypes.c_void_p
            h = k32.OpenProcess(0x1000, False, pid)  # PROCESS_QUERY_LIMITED_INFORMATION
            if not h:
                return ctypes.GetLastError() != 87  # ERROR_INVALID_PARAMETER: no such process
            code = ctypes.c_ulong()
            ok = k32.GetExitCodeProcess(ctypes.c_void_p(h), ctypes.byref(code))
            k32.CloseHandle(ctypes.c_void_p(h))
            return not ok or code.value == 259  # STILL_ACTIVE
        except Exception:
            return True
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        return True  # exists, not ours to signal
    return True


def _pid_in(path):
    try:
        with open(path, encoding="utf-8") as f:
            return int(f.read().split()[0])
    except (OSError, ValueError, IndexError):
        return None


def _dead(lock):
    """True only if the lock's owner and its command are both provably gone, on this host."""
    parts = (_owner(lock) or "").split("|")
    if len(parts) < 4 or parts[3] != socket.gethostname():
        return False
    try:
        wrapper = int(parts[1])
    except ValueError:
        return False
    if _alive(wrapper):
        return False
    child = _pid_in(os.path.join(lock, "child"))
    return child is None or not _alive(child)


def _ticket_dead(path):
    """A ticket whose waiter's process is gone, on this host, need not wait out its time to live."""
    try:
        with open(path, encoding="utf-8") as f:
            parts = f.read().strip().split("|")
        return len(parts) >= 4 and parts[3] == socket.gethostname() and not _alive(int(parts[1]))
    except (OSError, ValueError):
        return False


def _clear_stale(lock):
    gone = f"{lock}.stale-{os.getpid()}-{time.time_ns()}"
    try:
        os.rename(lock, gone)  # atomic: of two waiters, one wins
    except OSError:
        return
    shutil.rmtree(gone, ignore_errors=True)


def _terminate(proc):
    if proc.poll() is not None:
        return
    try:
        if os.name == "nt":
            subprocess.run(["taskkill", "/T", "/F", "/PID", str(proc.pid)], capture_output=True)
        else:
            os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
    except OSError:
        proc.terminate()
    try:
        proc.wait(10)
    except subprocess.TimeoutExpired:
        proc.kill()


def run(argv):
    o = _opts(argv)
    cmd = o["cmd"]
    if not cmd:
        print("gate-lock: no command after --", file=sys.stderr)
        return EX_USAGE
    lock, q = o["lock"], o["lock"] + ".q"
    os.makedirs(q, exist_ok=True)
    token = f"{o['owner']}|{os.getpid()}|{time.time_ns()}|{socket.gethostname()}"
    ticket = os.path.join(q, f"{time.time_ns():020d}-{os.getpid()}")
    with open(ticket, "w", encoding="utf-8") as f:
        f.write(token)
    ticket_ttl = max(30.0, o["poll"] * 10)
    started = last_report = time.time()
    held = False
    old_term = signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(SystemExit(143)))
    try:
        while True:
            os.utime(ticket)
            for t in os.listdir(q):  # drop tickets of waiters that died
                p = os.path.join(q, t)
                try:
                    if p != ticket and (time.time() - os.stat(p).st_mtime > ticket_ttl or _ticket_dead(p)):
                        os.remove(p)
                except OSError:
                    pass
            blocked = False
            for other in o["wait_free"]:
                if os.path.exists(other):
                    if _age(other) > o["stale"]:
                        _clear_stale(other)
                    else:
                        blocked = True
            tickets = sorted(os.listdir(q))
            if not blocked and tickets and tickets[0] == os.path.basename(ticket):
                if os.path.exists(lock) and (_age(lock) > o["stale"] or _dead(lock)):
                    _clear_stale(lock)
                try:
                    os.mkdir(lock)  # the only thing that makes the lock ours
                except FileExistsError:
                    pass
                else:
                    held = True
                    with open(os.path.join(lock, "owner"), "w", encoding="utf-8") as f:
                        f.write(f"{token}\n{time.strftime('%Y-%m-%d %H:%M:%S')}\n{' '.join(cmd)}\n")
                    break
            if o["timeout"] and time.time() - started > o["timeout"]:
                print(f"gate-lock: gave up after {o['timeout'] / 60:.1f} min waiting for {lock}", file=sys.stderr)
                return EX_WAIT
            if time.time() - last_report > o["report"]:
                last_report = time.time()
                who = (_owner(lock) or "?").split("|")[0]
                print(f"gate-lock: waiting {int((time.time() - started) / 60)} min; held by {who}",
                      file=sys.stderr, flush=True)
            time.sleep(o["poll"])
        exe = shutil.which(cmd[0]) or cmd[0]
        kw = {"start_new_session": True} if os.name != "nt" else {}
        proc = subprocess.Popen([exe, *cmd[1:]], **kw)
        try:
            with open(os.path.join(lock, "child"), "w", encoding="utf-8") as f:
                f.write(str(proc.pid))
        except OSError:
            pass
        try:
            return proc.wait()
        except BaseException:
            _terminate(proc)
            raise
    finally:
        signal.signal(signal.SIGTERM, old_term)
        try:
            os.remove(ticket)
        except OSError:
            pass
        if held:
            if _owner(lock) == token:
                shutil.rmtree(lock, ignore_errors=True)
            else:
                print(f"gate-lock: the lock now belongs to {_owner(lock)!r}; not releasing it", file=sys.stderr)


def status(argv):
    lock = _opts(argv)["lock"]
    if not os.path.isdir(lock):
        print("free")
        return 0
    who = (_owner(lock) or "(no owner file yet)").split("|")[0]
    print(f"held by {who} for {int(_age(lock))} s")
    return 1


def _opts(argv):
    o = {"lock": DEFAULT_LOCK, "owner": f"{getpass.getuser()}@{socket.gethostname()}", "stale": 30 * 60.0,
         "timeout": 0.0, "poll": 5.0, "report": 300.0, "wait_free": [], "cmd": []}
    names = {"--lock": ("lock", str), "--owner": ("owner", str), "--stale-min": ("stale", lambda v: float(v) * 60),
             "--timeout-min": ("timeout", lambda v: float(v) * 60), "--poll": ("poll", float),
             "--report-min": ("report", lambda v: float(v) * 60)}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            o["cmd"] = argv[i + 1:]
            break
        if a == "--wait-free" or a in names:
            if i + 1 >= len(argv):
                print(f"gate-lock: {a} needs a value", file=sys.stderr)
                raise SystemExit(EX_USAGE)
        if a == "--wait-free":
            o["wait_free"].append(argv[i + 1]); i += 2
        elif a in names:
            key, conv = names[a]
            o[key] = conv(argv[i + 1]); i += 2
        else:
            print(f"gate-lock: unknown option {a}", file=sys.stderr)
            raise SystemExit(EX_USAGE)
    return o


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    try:
        if argv[0] == "run":
            return run(argv[1:])
        if argv[0] == "status":
            return status(argv[1:])
    except ValueError:
        print("gate-lock: bad option value", file=sys.stderr)
        return EX_USAGE
    print(f"gate-lock: unknown command {argv[0]!r}", file=sys.stderr)
    return EX_USAGE


def _self_test():
    me = os.path.abspath(__file__)
    py = sys.executable
    with tempfile.TemporaryDirectory() as d:
        lock = os.path.join(d, "g.lock")
        log = os.path.join(d, "log.txt")
        base = ["--lock", lock, "--poll", "0.05", "--owner", "t"]

        def gl(*extra, cmd=None, wait=True):
            args = [py, "-I", me, "run", *base, *extra, "--", *(cmd or [py, "-c", "pass"])]
            p = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            if not wait:
                return p
            out, err = p.communicate(timeout=60)
            return p.returncode, err

        def job(tag, secs):
            return [py, "-c", f"import time;f=open({log!r},'a');f.write('start {tag}\\n');f.flush();"
                              f"time.sleep({secs});f.write('end {tag}\\n');f.close()"]

        # the command's exit code comes back, and the lock and the ticket are gone after it
        assert gl(cmd=[py, "-c", "import sys;sys.exit(0)"])[0] == 0
        assert gl(cmd=[py, "-c", "import sys;sys.exit(7)"])[0] == 7
        assert not os.path.exists(lock) and os.listdir(lock + ".q") == []
        # mutual exclusion and first come, first served: three runs never overlap, and the slow poller that
        # queued before a fast one is served before it (without a queue the fast poller would win)
        ps = []
        for i in range(3):
            ps.append(gl("--poll", "0.6" if i == 1 else "0.05", cmd=job(i, 1.2 if i == 0 else 0.3), wait=False))
            time.sleep(0.25)
        assert all(p.wait(60) == 0 for p in ps)
        assert open(log).read().split() == ["start", "0", "end", "0", "start", "1", "end", "1", "start", "2", "end", "2"], \
            open(log).read()
        # the lock is released only if its owner file still names this run
        rc, err = gl(cmd=[py, "-c", f"open({lock!r}+'/owner','w').write('someone-else|1|1\\n')"])
        assert rc == 0 and os.path.isdir(lock) and "not releasing" in err, (rc, err)
        shutil.rmtree(lock)
        # a stale lock is removed; a fresh lock with no owner file (a sibling mid-acquire) is never taken
        os.mkdir(lock)
        os.utime(lock, (time.time() - 7200, time.time() - 7200))
        assert gl("--stale-min", "30")[0] == 0 and not os.path.exists(lock)
        os.mkdir(lock)
        rc, err = gl("--timeout-min", "0.01")
        assert rc == EX_WAIT and os.path.isdir(lock) and not os.path.exists(os.path.join(lock, "owner")), (rc, err)
        # status: exit code 1 while held, 0 when free
        p = subprocess.run([py, "-I", me, "status", "--lock", lock], capture_output=True, text=True)
        assert p.returncode == 1 and "no owner file" in p.stdout
        os.rmdir(lock)
        p = subprocess.run([py, "-I", me, "status", "--lock", lock], capture_output=True, text=True)
        assert p.returncode == 0 and p.stdout.strip() == "free"
        # a lock whose wrapper was killed hard is cleared at once; one that may still be running is not
        host = socket.gethostname()
        gone = subprocess.Popen([py, "-c", "pass"])
        gone.wait()
        sleeper = subprocess.Popen([py, "-c", "import time;time.sleep(120)"])

        def held_by(pid, host=host, child=None):
            if os.path.exists(lock):
                shutil.rmtree(lock)
            os.mkdir(lock)
            with open(os.path.join(lock, "owner"), "w") as f:
                f.write(f"x|{pid}|1|{host}\n")
            if child is not None:
                with open(os.path.join(lock, "child"), "w") as f:
                    f.write(str(child))

        assert not _alive(0) and not _alive(-1) and _alive(os.getpid()) and not _alive(gone.pid)
        try:
            held_by(gone.pid)
            assert gl()[0] == 0 and not os.path.exists(lock)
            held_by(gone.pid, child=gone.pid)
            assert gl()[0] == 0 and not os.path.exists(lock)
            for why, args in (("live wrapper", dict(pid=os.getpid())),
                              ("another host", dict(pid=gone.pid, host=host + "-other")),
                              ("command still running", dict(pid=gone.pid, child=sleeper.pid)),
                              ("no pid in the owner", dict(pid="?"))):
                held_by(**args)
                rc, err = gl("--timeout-min", "0.01")
                assert rc == EX_WAIT and os.path.isdir(lock), (why, rc, err)
            # a real run records its command's pid beside the owner
            shutil.rmtree(lock)
            p = gl(cmd=[py, "-c", "import time;time.sleep(60)"], wait=False)
            for _ in range(200):
                if os.path.exists(os.path.join(lock, "child")):
                    break
                time.sleep(0.05)
            kid = _pid_in(os.path.join(lock, "child"))
            assert kid is not None and _alive(kid) and kid != p.pid
            p.kill()  # hard: no handler runs, the lock stays and so does the command
            p.wait()  # not communicate(): the command still holds the pipes
            assert os.path.isdir(lock), "lock gone"
            assert _alive(kid), "child gone"
            rc, err = gl("--timeout-min", "0.01")
            assert rc == EX_WAIT, (rc, err)  # the command still runs: the lock is still its
            if os.name == "nt":
                subprocess.run(["taskkill", "/F", "/PID", str(kid)], capture_output=True)
            else:
                os.kill(kid, signal.SIGKILL)
            for _ in range(100):
                if not _alive(kid):
                    break
                time.sleep(0.05)
            assert gl()[0] == 0 and not os.path.exists(lock)  # both gone: cleared without the stale wait
            # a queued ticket whose waiter was killed is dropped at once; a live waiter's, or another host's, is not
            def ticket(pid, host):
                with open(os.path.join(lock + ".q", f"{1:020d}-{pid}"), "w") as f:
                    f.write(f"x|{pid}|1|{host}")
            ticket(gone.pid, host)
            assert gl("--timeout-min", "0.2")[0] == 0
            for t in os.listdir(lock + ".q"):
                os.remove(os.path.join(lock + ".q", t))
            ticket(os.getpid(), host)
            assert gl("--timeout-min", "0.01")[0] == EX_WAIT
            for t in os.listdir(lock + ".q"):
                os.remove(os.path.join(lock + ".q", t))
            ticket(gone.pid, host + "-other")
            assert gl("--timeout-min", "0.01")[0] == EX_WAIT
            for t in os.listdir(lock + ".q"):
                os.remove(os.path.join(lock + ".q", t))
        finally:
            sleeper.kill()
            sleeper.wait()
            if os.path.exists(lock):
                shutil.rmtree(lock, ignore_errors=True)
        # a dead waiter's old ticket does not block the queue
        os.makedirs(lock + ".q", exist_ok=True)
        dead = os.path.join(lock + ".q", "0" * 20 + "-1")
        open(dead, "w").close()
        os.utime(dead, (time.time() - 3600, time.time() - 3600))
        assert gl()[0] == 0
        # --wait-free: waits while the other lock is held, goes when it clears
        slot = os.path.join(d, "slot.lock")
        os.mkdir(slot)
        assert gl("--wait-free", slot, "--timeout-min", "0.01")[0] == EX_WAIT
        p = gl("--wait-free", slot, wait=False)
        time.sleep(0.4)
        assert p.poll() is None
        os.rmdir(slot)
        assert p.wait(30) == 0
        os.mkdir(slot)  # a stale slot is cleared, not waited on forever
        os.utime(slot, (time.time() - 7200, time.time() - 7200))
        assert gl("--wait-free", slot, "--stale-min", "30", "--timeout-min", "0.1")[0] == 0 and not os.path.exists(slot)
        # SIGTERM releases the lock and stops the command (POSIX; Windows has no catchable SIGTERM)
        if os.name != "nt":
            p = gl(cmd=[py, "-c", "import time;time.sleep(60)"], wait=False)
            for _ in range(100):
                if os.path.isdir(lock):
                    break
                time.sleep(0.05)
            assert os.path.isdir(lock)
            p.send_signal(signal.SIGTERM)
            p.wait(30)
            assert not os.path.exists(lock)
        # `--self-test` after the `--` belongs to the wrapped command, which runs under the lock
        got = os.path.join(d, "got.txt")
        rc, err = gl(cmd=[py, "-c", f"import sys;open({got!r},'w').write(' '.join(sys.argv[1:]))", "--self-test"])
        assert rc == 0 and open(got).read() == "--self-test", (rc, err)
        # usage errors
        assert subprocess.run([py, "-I", me, "run", "--lock", lock], capture_output=True).returncode == EX_USAGE
        assert subprocess.run([py, "-I", me, "run", "--bogus", "--", "x"], capture_output=True).returncode == EX_USAGE
        assert subprocess.run([py, "-I", me, "run", "--lock"], capture_output=True).returncode == EX_USAGE
    print("self-test OK: exit code passed through; lock and ticket released; three waiters strictly one at a time "
          "and in order; a foreign owner file is never released; stale lock cleared, ownerless fresh lock never taken; a lock whose wrapper and command are both gone is cleared at once, one with either alive or on another host is not; "
          "status exit codes; dead tickets ignored; --wait-free; SIGTERM releases; usage errors")


if __name__ == "__main__":
    if sys.argv[1:2] == ["--self-test"]:
        _self_test()
    else:
        sys.exit(main(sys.argv[1:]))
